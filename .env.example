# Used by host-side tools (bun test, drizzle studio). Compose overrides
# DATABASE_URL / S3_ENDPOINT inside containers to use service hostnames.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/zany_ihub
BETTER_AUTH_SECRET=replace-with-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000

# MinIO (local S3). Compose overrides S3_ENDPOINT to http://minio:9000
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=zany-ihub
S3_REGION=us-east-1
